ht="40" as="geometry"/></mxCell><mxCell id="eru-e37" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c36" target="eru-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c38" value="nota" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="347.5" y="410" width="70" height="40" as="geometry"/></mxCell><mxCell id="eru-e39" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c38" target="eru-c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c40" value="código" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="452.5" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="eru-e41" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c40" target="eru-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c42" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="547.5" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="eru-e43" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c42" target="eru-c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c44" value="código" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;fontStyle=4;" vertex="1" parent="1"><mxGeometry x="780.0" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="eru-e45" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c44" target="eru-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c46" value="nombre" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="875.0" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="eru-e47" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c46" target="eru-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c48" value="campus" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970.0" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="eru-e49" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="eru-c48" target="eru-c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eru-c50" value="&lt;b&gt;Enunciado de ejemplo:&lt;/b&gt; la universidad guarda sus alumnos, profesores y asignaturas. Un alumno se matricula en varias asignaturas y de cada matrícula se guarda el curso y la nota. Una asignatura la imparten uno o varios profesores. Cada asignatura pertenece a un único grado, y cada grado lo oferta una única facultad.&lt;br&gt;&lt;br&gt;Clave primaria = atributo subrayado. (mín,máx) junto a cada entidad: cuántas veces aparece esa entidad por cada elemento de la otra. Ej.: una asignatura pertenece a (1,1) grado; un grado tiene (1,N) asignaturas. Dentro del rombo: tipo de relación (1:N o N:M)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="100" as="geometry"/></mxCell><mxCell id="eru-c51" value="&lt;b&gt;Paso a tablas&lt;/b&gt; (si te lo piden):&lt;br&gt;ALUMNO (&lt;u&gt;DNI&lt;/u&gt;, nombre, email)&lt;br&gt;PROFESOR (&lt;u&gt;DNI&lt;/u&gt;, nombre, despacho)&lt;br&gt;FACULTAD (&lt;u&gt;código&lt;/u&gt;, nombre, campus)&lt;br&gt;GRADO (&lt;u&gt;código&lt;/u&gt;, nombre, cod_facultad → FACULTAD)&lt;br&gt;ASIGNATURA (&lt;u&gt;código&lt;/u&gt;, nombre, créditos, cod_grado → GRADO)&lt;br&gt;MATRICULA (&lt;u&gt;DNI_alumno&lt;/u&gt; → ALUMNO, &lt;u&gt;cod_asignatura&lt;/u&gt; → ASIGNATURA, curso, nota)&lt;br&gt;IMPARTE (&lt;u&gt;DNI_profesor&lt;/u&gt; → PROFESOR, &lt;u&gt;cod_asignatura&lt;/u&gt; → ASIGNATURA)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="420" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
